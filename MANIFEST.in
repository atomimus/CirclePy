include LICENSE README.md CONTRIBUTING.md requirements.txt constraints-dev.txt
include docs/transports.md
include docs/clients.md
recursive-include circlepy *.py
recursive-include tests *.py *.json *.md
recursive-include tools *.py
recursive-include .github *.yml
recursive-include api/specs *.yaml *.json *.txt
prune docs/v1-release
global-exclude *.py[cod] .env .env.* .pypirc
